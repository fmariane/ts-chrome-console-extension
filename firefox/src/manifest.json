{
  "manifest_version": 3,
  "name": "TypeScript Console",
  "version": "0.3.0",
  "description": "A TypeScript playground inside DevTools with temporary file tabs, import/export, type checking and quick fixes.",
  "devtools_page": "devtools.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"
  },
  "permissions": [
    "devtools"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "typescript-console@local.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
